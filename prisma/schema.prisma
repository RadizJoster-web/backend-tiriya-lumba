generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  POOL_MANAGER
  INSTRUCTOR
  STUDENT
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  CASH
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationType {
  NEW_STUDENT
  NEW_INSTRUCTOR
  RENEWAL
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                String             @id @default(uuid())
  fullName          String // Tambahan Nama Lengkap
  phone             String? // Tambahan No. Telepon
  email             String             @unique
  password          String
  role              Role
  otpCode           String?
  otpExpiresAt      DateTime?
  isVerified        Boolean            @default(false)
  profilePictureUrl String?
  locationId        String?
  location          Location?          @relation(fields: [locationId], references: [id])
  isActive          Boolean            @default(true)
  studentProfile    StudentProfile?
  schedules         Schedule[]         @relation("InstructorSchedules")
  InstructorProfile InstructorProfile?
}

model Area {
  id        String     @id @default(uuid())
  name      String     @unique // Contoh: "Tangerang Selatan", "Jakarta Selatan", "Bintaro"
  locations Location[] // Relasi: 1 Area menampung banyak Kolam (Location)
}

model Location {
  id       String    @id @default(uuid())
  name     String // Contoh: "Kolam Renang Graha Raya"
  category String // Kerjasama Tangerang, Non-Kerjasama, dll.
  mapUrl   String?
  areaId   String? // Menyimpan UUID dari tabel Area
  area     Area?     @relation(fields: [areaId], references: [id])
  packages Package[]

  // Relasi One-to-Many (Untuk Manager/Student)
  users User[]

  // Relasi Many-to-Many (Untuk Instructor) 
  instructors InstructorProfile[] @relation("InstructorLocations")
  schedules   Schedule[]

  @@unique([name, areaId])
}

model Package {
  id         String   @id @default(uuid())
  locationId String
  type       String // Reguler, Privat, Prestasi, Ekskul[cite: 2]
  price      Float
  location   Location @relation(fields: [locationId], references: [id])
}

model SessionTime {
  id          String  @id @default(uuid())
  dayOfWeek   String // Senin, Selasa, dll.[cite: 2]
  sessionName String // Sesi 1[cite: 2]
  startTime   String // "09:00"[cite: 2]
  endTime     String // "10:00"[cite: 2]
  locationId  String? // Jika null, berlaku global. Jika terisi, spesifik kolam.[cite: 2]
}

model StudentProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  fullName       String       // Nama lengkap murid / anak yang ikut les 
  birthPlace     String
  birthDate      DateTime
  gender         String
  address        String
  schoolOrOffice String
  tshirtSize     String // XS, S, M, L, XL, XXL[cite: 3]
  activeSessions Int          @default(0)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
}

model InstructorProfile {
  id         String     @id @default(uuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortBio   String?    @db.Text // Profil singkat (menggunakan Text agar bisa panjang)
  license    String? // Lisensi (misal: "AIFO", "Lisensi D", dll)
  experience String? // Pengalaman (misal: "5 Tahun")
  locations  Location[] @relation("InstructorLocations")
}

model Registration {
  id              String             @id @default(uuid())
  userId          String // Referensi pendaftar[cite: 3]
  type            RegistrationType
  status          RegistrationStatus @default(PENDING)
  rejectionReason String? // Wajib diisi admin jika status = REJECTED[cite: 3]

  // Data Pendaftaran Murid (Booking)[cite: 3]
  packageId        String?
  locationId       String?
  instructorId     String?
  firstMeetDate    DateTime? // Rencana pertemuan ke-1[cite: 3]
  firstMeetSession String?

  // Data Pembayaran & File (Multer)[cite: 3]
  paymentMethod   PaymentMethod?
  paymentProofUrl String? // Foto transfer / dokumentasi serah uang cash[cite: 3]
  cvUrl           String? // CV (Pelatih)[cite: 4]
}

model Schedule {
  id           String   @id @default(uuid())
  instructorId String
  instructor   User     @relation("InstructorSchedules", fields: [instructorId], references: [id]) // 👈 Tambahkan baris ini
  studentId    String?
  dayOfWeek    String
  sessionName  String
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
}

model Attendance {
  id               String         @id @default(uuid())
  studentProfileId String
  date             DateTime       @default(now())
  status           String // "Hadir" / "Tidak Hadir"
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
}
