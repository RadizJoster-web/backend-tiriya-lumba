generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  POOL_MANAGER
  INSTRUCTOR
  STUDENT
  USER
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  CASH
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationType {
  NEW_STUDENT
  NEW_INSTRUCTOR
  RENEWAL
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                String             @id @default(uuid())
  fullName          String
  phone             String?
  email             String             @unique
  password          String
  role              Role               @default(USER)
  otpCode           String?
  otpExpiresAt      DateTime?
  resetToken        String?
  resetTokenExpiresAt DateTime?
  isVerified        Boolean            @default(false)
  profilePictureUrl String?
  locationId        String?
  location          Location?          @relation(fields: [locationId], references: [id])
  isActive          Boolean            @default(true)
  studentProfile    StudentProfile?
  schedules         Schedule[]         @relation("InstructorSchedules")
  instructorProfile InstructorProfile?
  registrations     Registration[]
}

model Area {
  id        String     @id @default(uuid())
  name      String     @unique // Contoh: "Tangerang Selatan", "Jakarta Selatan", "Bintaro"
  locations Location[] // Relasi: 1 Area menampung banyak Kolam (Location)
}

model Location {
  id       String    @id @default(uuid())
  name     String // Contoh: "Kolam Renang Graha Raya"
  category String // Kerjasama Tangerang, Non-Kerjasama, dll.
  mapUrl   String?
  areaId   String? // Menyimpan UUID dari tabel Area
  area     Area?     @relation(fields: [areaId], references: [id])
  packages Package[]

  // Relasi One-to-Many (Untuk Manager/Student)
  users User[]

  // Relasi Many-to-Many (Untuk Instructor) 
  instructors InstructorProfile[] @relation("InstructorLocations")
  schedules   Schedule[]

  @@unique([name, areaId])
}

model Package {
  id           String   @id @default(uuid())
  locationId   String
  type         String // Reguler, Privat, Prestasi, Ekskul
  price        Float
  sessionCount Int      @default(4) // Jumlah pertemuan per paket (1 - 10)
  location     Location @relation(fields: [locationId], references: [id])
}

model SessionTime {
  id          String  @id @default(uuid())
  dayOfWeek   String // Senin, Selasa, dll.
  sessionName String // Sesi 1
  startTime   String // "09:00"
  endTime     String // "10:00"
  locationId  String? // Jika null, berlaku global. Jika terisi, spesifik kolam.
}

model StudentProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  fullName       String // Nama lengkap murid / anak yang ikut les 
  birthPlace     String
  birthDate      DateTime
  gender         String
  address        String
  schoolOrOffice String
  tshirtSize     String // XS, S, M, L, XL, XXL
  activeSessions Int          @default(0)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
}

model InstructorProfile {
  id                String     @id @default(uuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortBio          String?    @db.Text
  birthDate         DateTime   
  license           String?    @db.Text
  experience        String?
  locations         Location[] @relation("InstructorLocations")
  lastRescheduledAt DateTime?
}

model Registration {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            RegistrationType
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?

  // Data Pendaftaran Murid (Booking)
  packageId        String?
  locationId       String?
  instructorId     String?
  firstMeetDate    DateTime?
  firstMeetSession String?

  // Data Pembayaran & File
  paymentMethod   PaymentMethod?
  paymentProofUrl String?
  cvUrl           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}

model Schedule {
  id           String   @id @default(uuid())
  instructorId String
  instructor   User     @relation("InstructorSchedules", fields: [instructorId], references: [id])
  studentId    String?
  dayOfWeek    String
  sessionName  String
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
}

model Attendance {
  id               String          @id @default(uuid())
  studentProfileId String?
  instructorId     String?
  role             String          @default("Murid") // "Murid" / "Pelatih"
  name             String
  locationName     String
  date             DateTime        @default(now())
  status           String          // "Hadir" / "Tidak Hadir"
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
}
