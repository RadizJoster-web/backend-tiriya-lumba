generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  POOL_MANAGER
  INSTRUCTOR
  STUDENT
  USER
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  CASH
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationType {
  NEW_STUDENT
  NEW_INSTRUCTOR
  RENEWAL
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                String             @id @default(uuid()) @db.VarChar(36)
  fullName          String             @db.VarChar(100)
  phone             String?            @db.VarChar(20)
  email             String             @unique @db.VarChar(100)
  password          String             @db.VarChar(255)
  role              Role               @default(USER)
  otpCode           String?            @db.VarChar(10)
  otpExpiresAt      DateTime?
  resetToken        String?            @db.VarChar(255)
  resetTokenExpiresAt DateTime?
  isVerified        Boolean            @default(false)
  profilePictureUrl String?            @db.VarChar(255)
  locationId        String?            @db.VarChar(36)
  location          Location?          @relation(fields: [locationId], references: [id])
  isActive          Boolean            @default(true)
  studentProfile    StudentProfile?
  schedules         Schedule[]         @relation("InstructorSchedules")
  instructorProfile InstructorProfile?
  registrations     Registration[]

  @@index([role, isActive])
  @@index([locationId])
}

model Area {
  id        String     @id @default(uuid()) @db.VarChar(36)
  name      String     @unique @db.VarChar(100) // Contoh: "Tangerang Selatan", "Jakarta Selatan", "Bintaro"
  locations Location[] // Relasi: 1 Area menampung banyak Kolam (Location)
}

model Location {
  id                      String    @id @default(uuid()) @db.VarChar(36)
  name                    String    @db.VarChar(100) // Contoh: "Kolam Renang Graha Raya"
  category                String    @db.VarChar(50) // Kerjasama Tangerang, Non-Kerjasama, dll.
  mapUrl                  String?   @db.Text
  imageUrl                String?   @db.VarChar(255)
  isCoachRegistrationOpen Boolean   @default(true) // Status pendaftaran pelatih baru: BUKA (true) / TUTUP (false)
  areaId                  String?   @db.VarChar(36) // Menyimpan UUID dari tabel Area
  area                    Area?     @relation(fields: [areaId], references: [id])
  packages                Package[]

  // Relasi One-to-Many (Untuk Manager/Student)
  users User[]

  // Relasi Many-to-Many (Untuk Instructor) 
  instructors InstructorProfile[] @relation("InstructorLocations")
  schedules   Schedule[]

  @@unique([name, areaId])
}

model Package {
  id           String   @id @default(uuid()) @db.VarChar(36)
  locationId   String   @db.VarChar(36)
  type         String   @db.VarChar(50) // Reguler, Privat, Prestasi, Ekskul
  price        Float
  sessionCount Int      @default(4) // Jumlah pertemuan per paket (1 - 10)
  location     Location @relation(fields: [locationId], references: [id])

  @@index([locationId, type])
}

model SessionTime {
  id          String  @id @default(uuid()) @db.VarChar(36)
  dayOfWeek   String  @db.VarChar(15) // Senin, Selasa, dll.
  sessionName String  @db.VarChar(50) // Sesi 1
  startTime   String  @db.VarChar(10) // "09:00"
  endTime     String  @db.VarChar(10) // "10:00"
  locationId  String? @db.VarChar(36) // Jika null, berlaku global. Jika terisi, spesifik kolam.
}

model StudentProfile {
  id             String       @id @default(uuid()) @db.VarChar(36)
  userId         String       @unique @db.VarChar(36)
  fullName       String       @db.VarChar(100) // Nama lengkap murid / anak yang ikut les 
  birthPlace     String       @db.VarChar(50)
  birthDate      DateTime
  gender         String       @db.VarChar(20)
  address        String       @db.VarChar(255)
  schoolOrOffice String       @db.VarChar(100)
  tshirtSize     String       @db.VarChar(10) // XS, S, M, L, XL, XXL
  activeSessions Int          @default(0)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
}

model InstructorProfile {
  id                String     @id @default(uuid()) @db.VarChar(36)
  userId            String     @unique @db.VarChar(36)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shortBio          String?    @db.Text
  birthDate         DateTime   
  license           String?    @db.Text
  experience        String?    @db.VarChar(100)
  locations         Location[] @relation("InstructorLocations")
  lastRescheduledAt DateTime?
}

model Registration {
  id              String             @id @default(uuid()) @db.VarChar(36)
  userId          String             @db.VarChar(36)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            RegistrationType
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?            @db.VarChar(255)

  // Data Pendaftaran Murid (Booking)
  packageId        String?           @db.VarChar(36)
  locationId       String?           @db.VarChar(36)
  instructorId     String?           @db.VarChar(36)
  firstMeetDate    DateTime?
  firstMeetSession String?           @db.VarChar(50)

  // Data Pembayaran & File
  paymentMethod   PaymentMethod?
  paymentProofUrl String?            @db.VarChar(255)
  cvUrl           String?            @db.VarChar(255)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@index([status])
  @@index([userId])
  @@index([locationId, firstMeetSession, status])
  @@index([instructorId])
  @@index([createdAt])
}

model Schedule {
  id           String   @id @default(uuid()) @db.VarChar(36)
  instructorId String   @db.VarChar(36)
  instructor   User     @relation("InstructorSchedules", fields: [instructorId], references: [id])
  studentId    String?  @db.VarChar(36)
  dayOfWeek    String   @db.VarChar(15)
  sessionName  String   @db.VarChar(50)
  locationId   String   @db.VarChar(36)
  location     Location @relation(fields: [locationId], references: [id])

  @@index([locationId, dayOfWeek, sessionName])
  @@index([instructorId])
  @@index([studentId])
}

model Attendance {
  id               String          @id @default(uuid()) @db.VarChar(36)
  studentProfileId String?         @db.VarChar(36)
  instructorId     String?         @db.VarChar(36)
  role             String          @default("Murid") @db.VarChar(30) // "Murid" / "Pelatih"
  name             String          @db.VarChar(100)
  locationName     String          @db.VarChar(100)
  date             DateTime        @default(now())
  status           String          @db.VarChar(30) // "Hadir" / "Tidak Hadir"
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])

  @@index([date])
  @@index([date, locationName])
  @@index([studentProfileId])
  @@index([instructorId])
}
